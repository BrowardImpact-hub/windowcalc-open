{
  "expo": {
    "name": "WindowCalc",
    "slug": "windowcalc",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#14B8A6"
    },
    "ios": {
      "bundleIdentifier": "com.windowcalc.field",
      "supportsTablet": false,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.windowcalc.field",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#14B8A6"
      },
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication"
    ],
    "scheme": "windowcalc",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "windowcalc-mobile"
      }
    }
  }
}
